{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "settings": {
    "shadcn": {
      "ui": "@/components/ui",
      "note": "Design tokens live in src/index.css (@theme). Dynamic sizes go through CSS custom properties, e.g. className=\"w-(--w)\" style={{ \"--w\": ... }}."
    }
  },
  "rules": {
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          { "pattern": "^(CardContent|CardHeader)$", "allow": ["layout", "spacing"] },
          { "pattern": "^(CardTitle|CardDescription)$", "allow": ["layout", "typography"] }
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "react/exhaustive-deps": "warn",
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": { "shadcn/no-restyle": "off" }
    }
  ],
  "ignorePatterns": ["dist", "node_modules"]
}
